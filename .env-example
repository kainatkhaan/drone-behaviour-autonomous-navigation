# UAV Autonomous Navigation & Obstacle Avoidance Environment Configuration

# Simulator Settings
AIRSIM_HOST_IP=127.0.0.1
AIRSIM_PORT=41451
PX4_SITL_HOST=127.0.0.1
PX4_SITL_PORT=14540

# Dataset and Output Paths
OUTPUT_DIR=./output
DATASET_PATH=./output/drone_navigation_dataset.csv

# Trajectory Optimization Parameters
SOLVER_TYPE=DPM-Solver++
DIFFUSION_STEPS=20
CONVERGENCE_THRESHOLD=0.2

# Closed-Loop Flight Control Gains
PD_KP=12.0
PD_KD=5.0
PD_KI=0.3
